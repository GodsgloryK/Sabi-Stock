DATABASE_URL=postgresql://username:password@host/database?sslmode=require
FRONTEND_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500,http://127.0.0.1:5500,null
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Optional. Free key: https://aistudio.google.com/apikey
# Without a key the AI briefing and assistant fall back to deterministic rules.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
RESTOCK_LEAD_TIME_DAYS=3
